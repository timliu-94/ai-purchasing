# MySQL 8 / Alibaba Cloud RDS internal endpoint. URL-encode special characters.
DATABASE_URL=mysql://fieldledger:change-me@rm-example.mysql.rds.aliyuncs.com:3306/fieldledger
PORT=8787

# Uploaded photos/signatures still use local disk until OSS migration is enabled.
FIELDLEDGER_UPLOADS=/var/lib/fieldledger/uploads

OSS_REGION=oss-ap-southeast-1
OSS_INTERNAL=true
OSS_BUCKET=wenfu-purchasing
OSS_ACCESS_KEY_ID=replace-me
OSS_ACCESS_KEY_SECRET=replace-me
